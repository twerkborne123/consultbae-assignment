        "query": "SELECT \n  p.person_id,\n  p.canonical_name,\n  p.city,\n  GROUP_CONCAT(s.skill, ', ') AS skills\nFROM person p\nLEFT JOIN skill s ON p.person_id = s.person_id\nLEFT JOIN skill_category sc ON p.person_id = sc.person_id\nWHERE sc.person_id IS NULL\nGROUP BY p.person_id\nLIMIT 10;\n",
